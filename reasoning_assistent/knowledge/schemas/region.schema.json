{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaapjansen1977/reasoning_assistent/region.schema.json",
  "title": "Regionale klinische kennis — concept, data-only",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "created_on": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "draft_requires_clinical_review"
    },
    "activation": {
      "type": "object",
      "properties": {
        "clinically_reviewed": {
          "const": false
        },
        "automatic_advice_enabled": {
          "const": false
        },
        "reviewer": {
          "type": "null"
        },
        "review_date": {
          "type": "null"
        }
      },
      "required": [
        "clinically_reviewed",
        "automatic_advice_enabled",
        "reviewer",
        "review_date"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "population": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "population",
        "coverage",
        "exclusions",
        "known_gaps"
      ],
      "additionalProperties": false
    },
    "ai_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_contract": {
      "type": "object",
      "properties": {
        "states": {
          "const": [
            "not_discussed",
            "present",
            "denied",
            "unclear",
            "not_applicable"
          ]
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "time_context_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "verification_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "states",
        "required_fields",
        "time_context_values",
        "verification_values",
        "rules"
      ],
      "additionalProperties": false
    },
    "shared_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "string",
            "minLength": 1
          },
          "prognostic_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "therapeutically_modifiable_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "applies_to",
          "prognostic_factors",
          "therapeutically_modifiable_factors",
          "limitations",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "mechanism_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "clues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "assessment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "clues",
          "assessment",
          "limitations",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "ask_when": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "follow_up": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "routine",
              "safety"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "text",
          "ask_when",
          "purpose",
          "origin",
          "follow_up",
          "priority",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "type": "string",
            "minLength": 1
          },
          "diagnostic_clues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "risk_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "physical_assessment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "prognostic_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "therapeutically_modifiable_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "referral": {
            "type": "object",
            "properties": {
              "priority": {
                "enum": [
                  "routine",
                  "conditional"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "priority",
              "action",
              "route"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "evidence_status",
          "review_status",
          "diagnostic_clues",
          "risk_factors",
          "physical_assessment",
          "prognostic_factors",
          "therapeutically_modifiable_factors",
          "limitations",
          "question_ids",
          "source_ids",
          "referral"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "checked_on": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "type",
          "scope",
          "checked_on",
          "access",
          "year"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "required_review": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required_review",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "version",
    "language",
    "created_on",
    "schema_version",
    "status",
    "activation",
    "scope",
    "ai_rules",
    "evidence_contract",
    "shared_profiles",
    "mechanism_context",
    "questions",
    "conditions",
    "sources",
    "review"
  ],
  "additionalProperties": false
}
